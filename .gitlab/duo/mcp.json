{
  "mcpServers": {
    "pulse-readonly": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-m",
        "mcp_server.pulse_mcp",
        "--transport",
        "stdio"
      ],
      "env": {
        "PULSE_ENV_STAGING_URL": "https://staging.example.com",
        "PULSE_ENV_PRODUCTION_URL": "https://production.example.com",
        "PULSE_GITLAB_PROJECT": "<group>/<project>"
      },
      "approvedTools": true
    }
  }
}
